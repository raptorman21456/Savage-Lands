extends SceneTree

# The 32x32 weapon icons (assets/weapons/, generated by tools/gen_weapon_icons.gd),
# the drop-in slot for hand-made Legendary/Mythic art, the per-tier palette, and
# the Inventory's weapon cards built from them (plain titles, the quality as slowly
# turning pixel rays, damage, Might lock, best-quality-first order).

const BASES := ["spear", "greatsword", "hammer", "battle_axe", "dagger", "bow", "knuckle_gloves", "hand_picks"]
const MATERIALS := ["wood", "steel", "gold", "bone", "silver", "obsidian"]

func _collect_labels(node: Node) -> Array:
	var texts := []
	if node is Label:
		texts.append(node.text)
	for child in node.get_children():
		texts.append_array(_collect_labels(child))
	return texts

# The entry with this id among the cards on show.
func _shown(view, id: String) -> Dictionary:
	for e in view.shown:
		if str(e.id) == id:
			return e
	return {}

func _init() -> void:
	# Fixed seed: every random roll below repeats run to run, so a changed result
	# is a real change, not luck.
	seed(20260926)
	var icons_script = load("res://scripts/WeaponIcons.gd")
	var weapons_script = load("res://scripts/Weapons.gd")

	# --- The generated icon set ---
	var missing := 0
	var wrong_size := 0
	for base in BASES:
		for material in MATERIALS:
			var path := "res://assets/weapons/%s_%s.png" % [base, material]
			if not ResourceLoader.exists(path):
				missing += 1
				continue
			var img: Image = (load(path) as Texture2D).get_image()
			if img.get_width() != 32 or img.get_height() != 32:
				wrong_size += 1
	var club_ok: bool = ResourceLoader.exists("res://assets/weapons/club.png") and (load("res://assets/weapons/club.png") as Texture2D).get_width() == 32
	print("all 8 weapon types x 6 materials exist as 32x32 icons: missing=%d wrong_size=%d club=%s (expected 0, 0, true)" % [missing, wrong_size, club_ok])

	# --- Which icon a weapon gets ---
	var gold_spear: Dictionary = weapons_script.get_owned_variant("spear_fine_gold")
	var wood_spear: Dictionary = weapons_script.get_owned_variant("spear_worn_wood")
	print("material picks the picture: gold=%s wood=%s (expected .../spear_gold.png, .../spear_wood.png)" % [
		icons_script.path_for(gold_spear).get_file(), icons_script.path_for(wood_spear).get_file()
	])
	print("the Club has its own icon: %s (expected club.png)" % [icons_script.path_for(weapons_script.get_owned_variant("club")).get_file()])
	var legendary_axe: Dictionary = weapons_script.get_owned_variant("battle_axe_legendary_bone")
	var mythic_dagger: Dictionary = weapons_script.get_owned_variant("dagger_mythic")
	print("Legendary looks for hand-made art first, most specific first: %s (expected [legendary_battle_axe_bone, legendary_battle_axe, battle_axe_bone, battle_axe_steel, ...])" % [
		icons_script.candidate_paths(legendary_axe).slice(0, 4).map(func(p): return p.get_file().get_basename())
	])
	print("a Mythic (no material of its own) falls back to gold: %s (expected [mythic_dagger_gold, mythic_dagger, dagger_gold, ...])" % [
		icons_script.candidate_paths(mythic_dagger).slice(0, 3).map(func(p): return p.get_file().get_basename())
	])
	print("with no hand-made art present, Legendary still gets the generated icon: %s (expected battle_axe_bone.png)" % [icons_script.path_for(legendary_axe).get_file()])

	# Hand-made art dropped into the folder is picked up (and needs no editor import).
	var scratch := "user://weapon_icon_test"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(scratch))
	for name in ["legendary_battle_axe", "legendary_dagger_gold", "generic_only"]:
		var pic := Image.create(32, 32, false, Image.FORMAT_RGBA8)
		pic.fill(Color(1, 0, 0))
		pic.save_png("%s/%s.png" % [scratch, name])
	var real_dir: String = icons_script.dir
	icons_script.dir = scratch
	print("a hand-made legendary_<base>.png is used for a Legendary of any material: %s (expected legendary_battle_axe.png)" % [icons_script.path_for(legendary_axe).get_file()])
	var legendary_gold_dagger: Dictionary = weapons_script.get_owned_variant("dagger_legendary_gold")
	var legendary_bone_dagger: Dictionary = weapons_script.get_owned_variant("dagger_legendary_bone")
	print("...and a per-material file beats it for that material: gold=%s bone=%s (expected legendary_dagger_gold.png, weapon_dagger.png: no generated icons in the scratch folder, so the old 20px one)" % [
		icons_script.path_for(legendary_gold_dagger).get_file(), icons_script.path_for(legendary_bone_dagger).get_file()
	])
	var raw_texture: Texture2D = icons_script.texture_for(legendary_axe)
	print("a PNG the editor hasn't imported still loads: %s size=%s (expected true, (32, 32))" % [raw_texture != null, raw_texture.get_size() if raw_texture != null else "none"])
	icons_script.dir = real_dir
	print("a non-legendary weapon ignores hand-made art: %s (expected spear_gold.png)" % [icons_script.path_for(gold_spear).get_file()])

	# --- Tier colours ---
	var seen := {}
	for tier in weapons_script.TIERS:
		seen[icons_script.TIER_COLORS[tier.tier_name].to_html()] = true
	var red: Color = icons_script.TIER_COLORS["Legendary"]
	print("every tier has its own colour (6 distinct): %d (expected 6)" % [seen.size()])
	print("Legendary is red: r=%.2f g=%.2f b=%.2f (expected r high, g and b low)" % [red.r, red.g, red.b])
	print("only Legendary and Mythic glow: %s (expected [Legendary, Mythic])" % [
		weapons_script.TIERS.filter(func(t): return icons_script.has_glow({"tier_name": t.tier_name})).map(func(t): return t.tier_name)
	])

	# --- Names ---
	print("names drop the tier (shown as a tag) and keep the material: %s | %s | %s | %s (expected Wooden Spear | Spear | Golden Greatsword | The Great Toothpicke)" % [
		icons_script.display_name(wood_spear), icons_script.display_name(weapons_script.get_owned_variant("spear_masterwork_steel")),
		icons_script.display_name(weapons_script.get_owned_variant("greatsword_fine_gold")), icons_script.display_name(weapons_script.get_owned_variant("spear_mythic"))
	])
	print("the Club is just Club, tagged Starter: %s / %s (expected Club / Starter)" % [
		icons_script.display_name(weapons_script.get_owned_variant("club")), icons_script.tier_label(weapons_script.get_owned_variant("club"))
	])

	# --- The Inventory cards (Gear tab) ---
	var main = load("res://Main.tscn").instantiate()
	root.add_child(main)
	await physics_frame
	await physics_frame
	var player = main.player
	for e in main.get_tree().get_nodes_in_group("enemies"):
		e.set_physics_process(false)
	player.owned_weapons = {}
	for id in ["club", "spear_fine_steel", "spear_worn_wood", "battle_axe_legendary_steel", "spear_mythic", "greatsword_masterwork_gold", "dagger_broken_bone"]:
		player.owned_weapons[id] = true
	player.weapon_enchantments["greatsword_masterwork_gold"] = "ember"
	player.weapon_upgrade_levels["spear_fine_steel"] = 2
	player.stat_might = 30
	player.attack_damage = 10
	player._equip_weapon(weapons_script.get_owned_variant("spear_fine_steel"))
	var panel = main.inventory_panel
	panel.open(player)
	var view = panel.gear_view
	var cards: Array = view.cards
	print("one card per owned weapon, all the same size: %d cards (expected 7), sizes=%s (expected all %s)" % [
		cards.size(), cards.map(func(c): return c.custom_minimum_size).all(func(s): return s == InvCard.SIZE), InvCard.SIZE
	])
	var order: Array = view.shown.map(func(e): return str(e.quality))
	print("best quality first, the Club last: %s (expected Mythic, Legendary, Masterwork, Fine, Worn, Broken, Starter)" % [", ".join(order)])
	print("the titles are just the weapon type, the Mythic keeping its own name: %s (expected The Great Toothpicke, Battle Axe, Greatsword, Spear, Spear, Dagger, Club)" % [", ".join(view.shown.map(func(e): return str(e.name)))])

	# the quality is the glow: rays by quality, none for Worn and the Club, a dark one for Broken
	print("rays by quality: %s (expected Mythic true, Legendary true, Masterwork true, Fine true, Worn false, Broken true, Starter false)" % [
		", ".join(["Mythic", "Legendary", "Masterwork", "Fine", "Worn", "Broken", "Starter"].map(func(q): return "%s %s" % [q, PixelRays.has_rays(q)]))
	])
	print("the ray colours: Fine grey=%s Masterwork blue=%s Legendary yellow=%s Mythic maroon=%s Broken dark=%s (expected all true)" % [
		PixelRays.GLOWS.Fine.color.r > 0.7 and absf(PixelRays.GLOWS.Fine.color.r - PixelRays.GLOWS.Fine.color.b) < 0.1,
		PixelRays.GLOWS.Masterwork.color.b > PixelRays.GLOWS.Masterwork.color.r,
		PixelRays.GLOWS.Legendary.color.r > 0.9 and PixelRays.GLOWS.Legendary.color.g > 0.7 and PixelRays.GLOWS.Legendary.color.b < 0.4,
		PixelRays.GLOWS.Mythic.color.r > 0.5 and PixelRays.GLOWS.Mythic.color.g < 0.2,
		PixelRays.GLOWS.Broken.color.v < 0.15,
	])
	print("the rays grow with the quality: %s (expected 8, 10, 12, 14)" % [", ".join(["Fine", "Masterwork", "Legendary", "Mythic"].map(func(q): return str(PixelRays.GLOWS[q].rays)))])
	print("only Mythic has a second, counter-turning ring: %s (expected [Mythic])" % [str(PixelRays.GLOWS.keys().filter(func(q): return bool(PixelRays.GLOWS[q].get("second", false))))])
	var rays_a: Dictionary = PixelRays.pace("spear_fine_steel")
	var rays_b: Dictionary = PixelRays.pace("spear_fine_steel")
	var rays_c: Dictionary = PixelRays.pace("dagger_fine_silver")
	print("each picture turns at its own pace, the same one every time: stable=%s (expected true), differs=%s (expected true), period in 26-72 s: %s (expected true)" % [
		rays_a == rays_b, rays_a != rays_c, rays_a.period_a >= 26.0 and rays_a.period_a <= 72.0
	])

	var fine := _shown(view, "spear_fine_steel")
	var masterwork := _shown(view, "greatsword_masterwork_gold")
	print("the equipped card is marked worn and shows its Blacksmith level and damage: worn=%s (expected true), sub='%s' (expected Steel · Fine +2), number=%s (expected %d)" % [
		cards[view.shown.find(fine)].worn, fine.sub, fine.number, player.weapon_damage_preview(weapons_script.get_owned_variant("spear_fine_steel"))
	])
	var masterwork_rows: Array = InvData.rows(player, null, masterwork)
	print("a card's detail shows its Might requirement and rune: %s (expected Needs MGT 8 and the Rune of Flame)" % [masterwork_rows.filter(func(r): return r[0] in ["Needs", "Rune"]).map(func(r): return "%s %s" % [r[0], r[2]])])
	print("the damage number is your Strength times the weapon: %d (expected %d)" % [
		player.weapon_damage_preview(weapons_script.get_owned_variant("greatsword_masterwork_gold")),
		int(round(10 * player._apply_enchantment_to_weapon(weapons_script.get_owned_variant("greatsword_masterwork_gold")).damage_mult))
	])

	# Might lock: the card dims, the button says why, and equipping is refused like in the shop.
	player.stat_might = 0
	panel._refresh()
	await process_frame  # the old cards are only freed at the end of the frame
	view = panel.gear_view
	var legendary := _shown(view, "battle_axe_legendary_steel")
	var legendary_card = view.cards[view.shown.find(legendary)]
	var locked_act: Dictionary = InvData.action_for(player, null, legendary)
	panel.apply_entry_action(null, legendary)
	print("with too little Might the card dims, the button says why and it won't equip: dim=%s (expected true), enabled=%s (expected false), reason='%s' (expected Needs %d MGT (you have 0).), equipped=%s (expected spear_fine_steel)" % [
		legendary_card.info.dim, locked_act.enabled, locked_act.reason, int(weapons_script.get_owned_variant("battle_axe_legendary_steel").required_might), player.current_weapon_base.id
	])
	player.stat_might = 30
	panel._refresh()
	await process_frame
	view = panel.gear_view
	panel.apply_entry_action(null, _shown(view, "battle_axe_legendary_steel"))
	print("...and equips once you have it: %s (expected battle_axe_legendary_steel)" % [player.current_weapon_base.id])

	panel.close()
	DirAccess.remove_absolute(ProjectSettings.globalize_path("%s/legendary_battle_axe.png" % scratch))
	DirAccess.remove_absolute(ProjectSettings.globalize_path("%s/legendary_dagger_gold.png" % scratch))
	DirAccess.remove_absolute(ProjectSettings.globalize_path("%s/generic_only.png" % scratch))
	quit()
