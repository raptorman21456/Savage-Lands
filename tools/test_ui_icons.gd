extends SceneTree

# The 16x16 UI icons (assets/ui/, generated by tools/gen_ui_icons.gd), the loader in scripts/UIIcons.gd, the drop-in slot
# for hand-made replacements, and the stat abbreviations (STR, VGR, AGI, RAGE, DXT, MAG, INM, RES, RFL, FTD, MGT).

func _init() -> void:
	var icons = load("res://scripts/UIIcons.gd")

	# --- Every icon the UI will ask for exists, is 16x16, and is actually drawn ---
	var names: Array = []
	for stat in icons.STAT_ORDER:
		names.append(icons.stat_icon(stat))
	for extra in ["health", "mana", "stamina", "damage", "defense", "speed", "crit", "luck", "level", "coin", "shard"]:
		names.append("stat_" + extra)
	for tab in icons.TABS + icons.OTHER_TAB_ICONS:
		names.append("tab_" + tab)
	for page in icons.GEAR_PAGES + icons.ITEM_PAGES + icons.SETTINGS_PAGES:
		names.append("sub_" + page)
	for pin in icons.PINS:
		names.append("pin_" + pin)
	for face in icons.FACES:
		names.append("face_" + face)
	names.append(icons.CURSOR)
	var missing: Array = []
	var wrong_size: Array = []
	var empty: Array = []
	var unoutlined: Array = []
	for icon_name in names:
		var tex: Texture2D = icons.texture(icon_name)
		if tex == null:
			missing.append(icon_name)
			continue
		var img: Image = tex.get_image()
		if img.get_width() != 16 or img.get_height() != 16:
			wrong_size.append(icon_name)
			continue
		var opaque := 0
		for y in 16:
			for x in 16:
				if img.get_pixel(x, y).a > 0.0:
					opaque += 1
		if opaque < 40:
			empty.append(icon_name)
		# The outer ring of the canvas is left for the outline, so a drawing never touches the edge. (The hand-made icons are drawn
		# on the whole 16x16 and have their own outlines, so only the generated ones are held to this.)
		var edge := 0
		for i in 16:
			if icons.HAND_MADE.has(icon_name):
				break
			for p in [Vector2i(i, 0), Vector2i(i, 15), Vector2i(0, i), Vector2i(15, i)]:
				if img.get_pixelv(p).a > 0.0 and img.get_pixelv(p) != Color.html("16100e"):
					edge += 1
		if edge > 0:
			unoutlined.append(icon_name)
	print("%d icons: stats, tabs and sub-tabs all exist: missing=%s wrong_size=%s nearly_empty=%s bleeding_off_the_edge=%s (expected [], [], [], [])" % [names.size(), missing, wrong_size, empty, unoutlined])
	var uniques := {}
	for icon_name in names:
		var tex2: Texture2D = icons.texture(icon_name)
		if tex2 != null:
			uniques[tex2.get_image().get_data().hex_encode()] = icon_name
	# Weapons and Potions deliberately share a picture with the stat or tab they stand for (Armour and Shields have drawings of their own now).
	print("icons are distinct apart from the two shared on purpose: %d distinct of %d (expected %d)" % [uniques.size(), names.size(), names.size() - 2])

	# --- The hand-drawn icons (the artists' replacements for generated ones, and the battle status pictures) ---
	var made_problems: Array = []
	for made_name in icons.HAND_MADE:
		var made_strip: Texture2D = icons.strip(made_name)
		var frames: int = icons.frame_count(made_name)
		if made_strip == null or made_strip.get_width() != 16 * frames or made_strip.get_height() != 16:
			made_problems.append(made_name)
			continue
	print("%d hand-drawn icons are in place, 16x16 (a strip of frames for the two eyes), nothing missing: %s (expected 22, [])" % [icons.HAND_MADE.size(), made_problems])
	print("the old 32x32 stand-ins are gone and sub_armour / sub_shields are the 16x16 hand-drawn ones: %s (expected true)" % [
		not icons.get_script_constant_map().has("OVERRIDES") and icons.texture("sub_armour").get_width() == 16 and icons.texture("sub_shields").get_width() == 16])
	var status_missing: Array = []
	for status_id in icons.STATUS_ICONS:
		if icons.path_for(icons.status_icon(status_id)) == "":
			status_missing.append(status_id)
	print("every status that has a picture finds its file (%d of them): missing=%s (expected [])" % [icons.STATUS_ICONS.size(), status_missing])
	print("a status with no picture gives '' (Stealth, Berserk, Stunned...): '%s' '%s' '%s' (expected '' '' '')" % [icons.status_icon("stealth"), icons.status_icon("berserk"), icons.status_icon("stunned")])
	print("the eyes are animated, the rest are stills: bloodboost=%d frames, bloodcrash=%d frames, poison=%d (expected 4, 5, 1); one frame comes out as a 16x16 texture: %s (expected (16, 16))" % [
		icons.frame_count("status_bloodboost"), icons.frame_count("status_bloodcrash"), icons.frame_count("status_poison"), icons.texture("status_bloodboost").get_size()])
	var eye: TextureRect = icons.rect("status_bloodboost", 32)
	root.add_child(eye)
	var eye_frames := {}
	for i in 12:
		await create_timer(0.05).timeout
		eye_frames[eye.frame_shown()] = true
	print("an animated icon plays itself: %d different frames over a moment (expected 2 or more), all within 0..3: %s (expected true)" % [eye_frames.size(), eye_frames.keys().all(func(f): return f >= 0 and f <= 3)])
	eye.queue_free()
	var still: TextureRect = icons.rect("status_poison", 32)
	print("a still icon is a plain TextureRect with its picture: %s (expected true)" % [still.get_script() == null and still.texture == icons.texture("status_poison")])
	still.free()

	# --- Stat names ---
	var expected := {"strength": "STR", "vigor": "VGR", "agility": "AGI", "rage": "RAGE", "dexterity": "DXT", "magic": "MAG", "intimidation": "INM", "resilience": "RES", "reflexes": "RFL", "fortitude": "FTD", "might": "MGT", "intelligence": "ITL"}
	var wrong: Array = []
	for stat in expected:
		if icons.stat_abbr(stat) != expected[stat]:
			wrong.append("%s=%s" % [stat, icons.stat_abbr(stat)])
	print("every stat goes by the abbreviation the user chose: wrong=%s (expected [])" % [wrong])
	var seen := {}
	for stat in icons.STAT_ORDER:
		seen[icons.stat_abbr(stat)] = true
	print("12 stats, 12 different abbreviations (ITL is Intelligence, INM is Intimidation), every one has an icon: %d stats, %d abbreviations, icons=%s (expected 12, 12, true)" % [
		icons.STAT_ORDER.size(), seen.size(), icons.STAT_ORDER.all(func(s): return icons.path_for(icons.stat_icon(s)) != "")
	])
	print("tooltips read name, abbreviation, what it does: %s | %s | %s (expected Strength (STR): attack power | Fortitude (FTD): magical defense | Might (MGT): heavy weapons)" % [
		icons.stat_tooltip("strength"), icons.stat_tooltip("fortitude"), icons.stat_tooltip("might")
	])
	print("an unknown id passes through untouched: %s / %s (expected luck / Luck)" % [icons.stat_abbr("luck"), icons.stat_name("luck")])

	# --- The menu frames ---
	var frame_problems: Array = []
	for frame_name in icons.KIT_MARGINS:
		var tex: Texture2D = icons.kit(frame_name)
		if tex == null:
			frame_problems.append(frame_name + " missing")
			continue
		var fimg: Image = tex.get_image()
		var m: int = icons.KIT_MARGINS[frame_name]
		if fimg.get_width() != fimg.get_height() or m * 2 >= fimg.get_width():
			frame_problems.append(frame_name + " bad size/margin")
		# every frame is chamfered, so its very corner is empty and its edge midpoint is the near-black outline
		if fimg.get_pixel(0, 0).a > 0.0 or fimg.get_pixel(fimg.get_width() / 2, 0) != Color.html("16100e"):
			frame_problems.append(frame_name + " corner/outline")
	print("%d menu frames exist, are square, have a sane margin, chamfered corners and the icons' outline: problems=%s (expected 13, [])" % [icons.KIT_MARGINS.size(), frame_problems])
	print("a frame name with no file gives null: %s (expected <null>)" % [icons.kit("nope")])

	# --- Drop-in replacement ---
	var scratch := "user://ui_icon_test"
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(scratch))
	var pic := Image.create(16, 16, false, Image.FORMAT_RGBA8)
	pic.fill(Color(1, 0, 0))
	pic.save_png("%s/stat_health.png" % scratch)
	var real_dir: String = icons.dir
	icons.dir = scratch
	var swapped: Texture2D = icons.texture("stat_health")
	print("a PNG dropped into the folder replaces the icon, no editor import needed: %s red=%s (expected true, true)" % [
		swapped != null, swapped != null and swapped.get_image().get_pixel(8, 8).r > 0.9
	])
	print("a name with no file gives nothing rather than an error: path='%s' texture=%s (expected '' and null)" % [icons.path_for("stat_nonexistent"), icons.texture("stat_nonexistent")])
	icons.dir = real_dir
	DirAccess.remove_absolute(ProjectSettings.globalize_path("%s/stat_health.png" % scratch))

	# --- As a control ---
	var control: TextureRect = icons.rect("tab_gear", 32)
	print("rect() gives a crisp 32px square: size=%s filter_nearest=%s (expected (32, 32), true)" % [control.custom_minimum_size, control.texture_filter == CanvasItem.TEXTURE_FILTER_NEAREST])
	control.free()
	quit()
