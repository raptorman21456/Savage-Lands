extends RefCounted
class_name UIIcons

# The small UI pictures (assets/ui/, 16x16, generated by tools/gen_ui_icons.gd) and the names stats go by: one place for
# "which icon is Fortitude", "what do we call it on screen" and "what does it do", so the inventory, the character sheet,
# the level-up screen and the tooltips all say the same thing.
#
# Files are named by group: stat_<id>.png, tab_<id>.png (the inventory's tabs) and sub_<id>.png (the pages inside a tab).
# A hand-made 16x16 PNG with the same name dropped into the folder simply replaces the generated one.
#
# Show them at a whole-number scale (16 -> 32) with nearest-neighbour filtering; rect() does that.

# Where the icons live. A variable (not a const) only so the tests can point it at a scratch folder.
static var dir := "res://assets/ui"

const TABS := ["gear", "items", "party", "map", "settings"]
# Not tabs any more (the character sheet is the first entry on the Party page, and talismans are a popup opened from a
# unit's Talismans line), but their pictures are still used: tab_character for "You", tab_talismans for that line and popup.
const OTHER_TAB_ICONS := ["character", "talismans"]
const GEAR_PAGES := ["weapons", "armour", "clothes", "shields"]
const ITEM_PAGES := ["potions", "food", "arrows"]
const SETTINGS_PAGES := ["audio", "controls", "gameplay"]
# Map pins (pin_<kind>), one per kind of place, and the busts of You and the party (face_<who>), shown big.
const PINS := ["town", "harbour", "chest", "boss", "here"]
const FACES := ["you", "knight", "necromancer", "druid", "rogue", "guardian", "marksman", "brawler", "shaman", "wolf"]
# The pointing arrow that marks what a menu is on.
const CURSOR := "ui_cursor"
# The 9-slice frames every menu is built from (assets/ui/kit/, drawn by tools/gen_ui_kit.gd in the icons' own style), and the
# patch margin each wants, in art pixels. Show them at the same whole-number scale as the icons (2x) with nearest filtering:
# a NinePatchRect or StyleBoxTexture with these margins.
const KIT_MARGINS := {
	"panel": 7, "panel_steel": 4, "inset": 4, "chip": 3,
	"button": 4, "button_hover": 4, "button_on": 4, "button_press": 4,
	"card": 6, "card_hover": 6, "card_worn": 6, "card_pick": 6, "card_worn_pick": 6,
}

# The level-up stats, in the order they are listed on screen: the short name shown everywhere, the full name, and what a
# point of it is for. Might is the one that gates the heavy weapon tiers (MGT on a weapon card).
const STAT_ORDER := ["might", "strength", "vigor", "agility", "rage", "dexterity", "magic", "intelligence", "intimidation", "resilience", "reflexes", "fortitude"]
const STAT_INFO := {
	"might": {"abbr": "MGT", "name": "Might", "does": "heavy weapons"},
	"strength": {"abbr": "STR", "name": "Strength", "does": "attack power"},
	"vigor": {"abbr": "VGR", "name": "Vigor", "does": "HP"},
	"agility": {"abbr": "AGI", "name": "Agility", "does": "speed"},
	"rage": {"abbr": "RAGE", "name": "Rage", "does": "upgrades berserk"},
	"dexterity": {"abbr": "DXT", "name": "Dexterity", "does": "crit"},
	"magic": {"abbr": "MAG", "name": "Magic", "does": "magic power"},
	# PROVISIONAL abbreviation: INT already belongs to Intimidation. A Might-type requirement: needed to learn a weapon's
	# specials in the first place, and what staffs ask for in place of Might.
	"intelligence": {"abbr": "INTL", "name": "Intelligence", "does": "learning specials; staffs"},
	"intimidation": {"abbr": "INT", "name": "Intimidation", "does": "shop prices"},
	"resilience": {"abbr": "RES", "name": "Resilience", "does": "defense"},
	"reflexes": {"abbr": "RFL", "name": "Reflexes", "does": "dodge chance"},
	"fortitude": {"abbr": "FTD", "name": "Fortitude", "does": "magical defense"},
}

# --- Stat names ------------------------------------------------------------------

# "STR". An id that is not a level-up stat is returned as it came.
static func stat_abbr(stat_id: String) -> String:
	return STAT_INFO.get(stat_id, {}).get("abbr", stat_id)

static func stat_name(stat_id: String) -> String:
	return STAT_INFO.get(stat_id, {}).get("name", stat_id.capitalize())

# "Strength (STR): attack power" -- for a hover tooltip.
static func stat_tooltip(stat_id: String) -> String:
	if not STAT_INFO.has(stat_id):
		return stat_id.capitalize()
	var info: Dictionary = STAT_INFO[stat_id]
	return "%s (%s): %s" % [info.name, info.abbr, info.does]

# --- The pictures ----------------------------------------------------------------

static func stat_icon(stat_id: String) -> String:
	return "stat_" + stat_id

# The file for an icon name ("stat_health", "tab_gear", "sub_potions"), or "" when there is none.
static func path_for(icon: String) -> String:
	var path := "%s/%s.png" % [dir, icon]
	if ResourceLoader.exists(path) or FileAccess.file_exists(path):
		return path
	return ""

static func texture(icon: String) -> Texture2D:
	var path := path_for(icon)
	if path == "":
		return null
	# Normally an imported resource; a PNG just dropped into the folder (the editor has not imported it yet) is read
	# straight from disk so it still shows up.
	if ResourceLoader.exists(path):
		return load(path)
	var img := Image.load_from_file(path)
	return ImageTexture.create_from_image(img) if img != null else null

# A menu frame by name ("panel", "button_on", "card_worn"...), or null when there is none.
static func kit(frame_name: String) -> Texture2D:
	var path := "%s/kit/%s.png" % [dir, frame_name]
	if ResourceLoader.exists(path):
		return load(path)
	if FileAccess.file_exists(path):
		var img := Image.load_from_file(path)
		return ImageTexture.create_from_image(img) if img != null else null
	return null

# The icon as a control, `px` pixels square (pass a multiple of 16 to keep the pixels crisp).
static func rect(icon: String, px: int = 32) -> TextureRect:
	var r := TextureRect.new()
	r.texture = texture(icon)
	r.custom_minimum_size = Vector2(px, px)
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.texture_filter = CanvasItem.TEXTURE_FILTER_NEAREST
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return r
